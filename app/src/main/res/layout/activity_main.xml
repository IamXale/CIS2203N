<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">   <!-- Adapts to theme -->

    <TextView
        android:id="@+id/calculation"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_margin="5dp"
        android:textAlignment="textEnd"
        android:textSize="56dp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_margin="5dp"
        android:textAlignment="textEnd"
        android:textSize="56dp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calculation" />

    <Button
        android:id="@+id/btnAC"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:text="CLEAR"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="@color/btn_function"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/result" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:text="DEL"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="@color/btn_function"
        app:layout_constraintLeft_toRightOf="@+id/btnAC"
        app:layout_constraintTop_toBottomOf="@+id/result" />

    <Button
        android:id="@+id/btn7"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="84dp"
        android:text="7"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAC" />

    <Button
        android:id="@+id/btn8"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="8"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btn7"
        app:layout_constraintTop_toBottomOf="@+id/btnAC" />

    <Button
        android:id="@+id/btn9"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="9"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btn8"
        app:layout_constraintTop_toBottomOf="@+id/btnDelete" />

    <Button
        android:id="@+id/btnDivide"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginTop="16dp"
        android:text="÷"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_operator"
        app:layout_constraintStart_toEndOf="@+id/btn9"
        app:layout_constraintTop_toBottomOf="@+id/btnDelete" />

    <Button
        android:id="@+id/btn4"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="84dp"
        android:text="4"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn7" />

    <Button
        android:id="@+id/btn5"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="5"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btn4"
        app:layout_constraintTop_toBottomOf="@+id/btn8" />

    <Button
        android:id="@+id/btn6"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="6"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btn5"
        app:layout_constraintTop_toBottomOf="@+id/btn9" />

    <Button
        android:id="@+id/btnMultiply"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginTop="16dp"
        android:text="*"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_operator"
        app:layout_constraintStart_toEndOf="@+id/btn6"
        app:layout_constraintTop_toBottomOf="@+id/btnDivide" />

    <Button
        android:id="@+id/btn1"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="84dp"
        android:text="1"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn4" />

    <Button
        android:id="@+id/btn2"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="2"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btn1"
        app:layout_constraintTop_toBottomOf="@+id/btn5" />

    <Button
        android:id="@+id/btn3"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="3"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btn2"
        app:layout_constraintTop_toBottomOf="@+id/btn6" />

    <Button
        android:id="@+id/btnSubtract"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginTop="16dp"
        android:text="-"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_operator"
        app:layout_constraintStart_toEndOf="@+id/btn3"
        app:layout_constraintTop_toBottomOf="@+id/btnMultiply" />

    <Button
        android:id="@+id/btnPeriod"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="84dp"
        android:text="."
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn1" />

    <Button
        android:id="@+id/btn0"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="0"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_number"
        app:layout_constraintStart_toEndOf="@+id/btnPeriod"
        app:layout_constraintTop_toBottomOf="@+id/btn2" />

    <Button
        android:id="@+id/btnEquals"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:text="="
        android:textSize="30sp"
        android:backgroundTint="@color/btn_equals"
        app:layout_constraintStart_toEndOf="@+id/btn0"
        app:layout_constraintTop_toBottomOf="@+id/btn3" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginTop="16dp"
        android:text="+"
        android:textSize="30sp"
        android:backgroundTint="@color/btn_operator"
        app:layout_constraintStart_toEndOf="@+id/btnEquals"
        app:layout_constraintTop_toBottomOf="@+id/btnSubtract" />

    <Button
        android:id="@+id/btnCustom"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_margin="5dp"
        android:layout_marginTop="16dp"
        android:text="918"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_operator"
        app:layout_constraintStart_toEndOf="@+id/btnEquals"
        app:layout_constraintTop_toBottomOf="@+id/btnAdd" />

</androidx.constraintlayout.widget.ConstraintLayout>